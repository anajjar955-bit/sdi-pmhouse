# ============================================================
# SDI® PMHouse — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم الفعلية
# ============================================================

# قاعدة البيانات (Railway يوفّره تلقائياً عند إضافة Postgres)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# JWT Secret — غيّره لقيمة عشوائية طويلة!
# مثال لتوليد: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-in-production

# بيئة التشغيل: production أو development
NODE_ENV=development

# المنفذ (Railway يضبطه تلقائياً)
PORT=3000

# حساب الأدمن الأولي (يُنشأ عند تشغيل `npm run migrate`)
ADMIN_EMAIL=anajjar@pmhouse.org
ADMIN_NAME=Akram Elnagar
ADMIN_PASSWORD=change-this-admin-password

# CORS: * للسماح للجميع، أو قائمة بفواصل مثل:
# CORS_ORIGIN=https://myapp.up.railway.app,https://custom-domain.com
CORS_ORIGIN=*
